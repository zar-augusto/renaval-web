---
import type { Language } from '../i18n/translations';
import { getTranslations } from '../i18n/translations';

interface Props {
  lang?: Language;
  currentPath?: string;
}

const { lang = 'es', currentPath = '/' } = Astro.props;
const t = getTranslations(lang);

// Definir enlaces base según el idioma
const prefix = lang === 'en' ? '/en' : '';
const homeUrl = lang === 'en' ? '/en/' : '/';
const aboutUrl = lang === 'en' ? '/en/about' : '/nosotros';
const esUrl = '/';
const enUrl = '/en/';
---

<nav
  class="fixed top-0 left-0 right-0 z-50 py-3.5 sm:py-4 bg-[#0A4B75]/95 backdrop-blur-md border-b border-white/10 transition-all duration-300"
  id="navbar"
>
  <div class="max-w-[1240px] mx-auto px-4 sm:px-6 flex items-center justify-between gap-3">
    <!-- LOGO -->
    <a
      href={homeUrl}
      class="flex items-center no-underline flex-shrink-0"
      aria-label={lang === 'en' ? 'ReNaval Home' : 'ReNaval Inicio'}
    >
      <img
        src="/images/logo-white.png"
        alt="ReNaval Logo"
        width="160"
        height="48"
        class="h-10 sm:h-12 w-auto object-contain drop-shadow-sm"
      />
    </a>

    <!-- LINKS ESCRITORIO -->
    <ul
      class="hidden md:flex items-center gap-1 lg:gap-2 list-none m-0 p-0"
      id="navLinks"
    >
      <li>
        <a
          href={`${homeUrl}#inicio`}
          class="block w-full md:w-auto text-white/85 no-underline text-base md:text-xs lg:text-sm font-medium px-3 lg:px-3.5 py-2 rounded-lg transition-colors hover:text-white hover:bg-white/10"
        >
          {t.nav.home}
        </a>
      </li>
      <li>
        <a
          href={aboutUrl}
          rel="about"
          class="block w-full md:w-auto text-white/85 no-underline text-base md:text-xs lg:text-sm font-medium px-3 lg:px-3.5 py-2 rounded-lg transition-colors hover:text-white hover:bg-white/10"
        >
          {t.nav.about}
        </a>
      </li>
      <li>
        <a
          href={`${homeUrl}#servicios`}
          class="block w-full md:w-auto text-white/85 no-underline text-base md:text-xs lg:text-sm font-medium px-3 lg:px-3.5 py-2 rounded-lg transition-colors hover:text-white hover:bg-white/10"
        >
          {t.nav.services}
        </a>
      </li>
      <li>
        <a
          href={`${homeUrl}#experiencia`}
          class="block w-full md:w-auto text-white/85 no-underline text-base md:text-xs lg:text-sm font-medium px-3 lg:px-3.5 py-2 rounded-lg transition-colors hover:text-white hover:bg-white/10"
        >
          {t.nav.experience}
        </a>
      </li>
      <li>
        <a
          href={`${homeUrl}#clientes`}
          class="block w-full md:w-auto text-white/85 no-underline text-base md:text-xs lg:text-sm font-medium px-3 lg:px-3.5 py-2 rounded-lg transition-colors hover:text-white hover:bg-white/10"
        >
          {t.nav.clients}
        </a>
      </li>
      <li>
        <a
          href={`${homeUrl}#galeria`}
          class="block w-full md:w-auto text-white/85 no-underline text-base md:text-xs lg:text-sm font-medium px-3 lg:px-3.5 py-2 rounded-lg transition-colors hover:text-white hover:bg-white/10"
        >
          {t.nav.gallery}
        </a>
      </li>
      <li>
        <a
          href={`${homeUrl}#casos-de-exito`}
          class="block w-full md:w-auto text-white/85 no-underline text-base md:text-xs lg:text-sm font-medium px-3 lg:px-3.5 py-2 rounded-lg transition-colors hover:text-white hover:bg-white/10"
        >
          {t.nav.cases}
        </a>
      </li>
      <li>
        <a
          href={`${homeUrl}#contacto`}
          class="block text-center w-full md:w-auto bg-[#F2B800] text-[#2D3137] font-bold rounded-lg px-3.5 lg:px-4 py-2 transition-transform hover:-translate-y-px hover:bg-[#e0aa00] text-base md:text-xs lg:text-sm no-underline ml-1"
        >
          {t.nav.quote}
        </a>
      </li>
      <!-- Selector de Idioma Desktop -->
      <li class="ml-1.5 flex items-center">
        <div
          class="inline-flex items-center text-xs font-semibold tracking-wider bg-white/10 hover:bg-white/15 border border-white/20 rounded-full p-0.5 transition-all shadow-sm"
          role="group"
          aria-label={lang === 'en' ? 'Language selector' : 'Selector de idioma'}
        >
          <a
            href={esUrl}
            class={`px-2.5 py-1 rounded-full text-[0.72rem] transition-all no-underline ${
              lang === 'es'
                ? 'bg-[#00A3E0] text-white font-bold shadow-sm'
                : 'text-white/70 hover:text-white'
            }`}
            title="Español (Principal)"
            aria-current={lang === 'es' ? 'true' : undefined}
          >
            ES
          </a>
          <a
            href={enUrl}
            class={`px-2.5 py-1 rounded-full text-[0.72rem] transition-all no-underline ${
              lang === 'en'
                ? 'bg-[#00A3E0] text-white font-bold shadow-sm'
                : 'text-white/70 hover:text-white'
            }`}
            title="English"
            aria-current={lang === 'en' ? 'true' : undefined}
          >
            EN
          </a>
        </div>
      </li>
    </ul>

    <!-- DERECHA MÓVIL: Selector de Idioma + Botón Hamburguesa -->
    <div class="flex items-center gap-2 md:hidden">
      <!-- Selector de Idioma Móvil (Sutil y siempre visible en cabecera) -->
      <div
        class="inline-flex items-center text-xs font-semibold tracking-wider bg-white/10 border border-white/20 rounded-full p-0.5 shadow-sm"
        role="group"
        aria-label="Language selector mobile"
      >
        <a
          href={esUrl}
          class={`px-2 py-0.5 rounded-full text-[0.7rem] transition-all no-underline ${
            lang === 'es'
              ? 'bg-[#00A3E0] text-white font-bold shadow-sm'
              : 'text-white/70 hover:text-white'
          }`}
          aria-current={lang === 'es' ? 'true' : undefined}
        >
          ES
        </a>
        <a
          href={enUrl}
          class={`px-2 py-0.5 rounded-full text-[0.7rem] transition-all no-underline ${
            lang === 'en'
              ? 'bg-[#00A3E0] text-white font-bold shadow-sm'
              : 'text-white/70 hover:text-white'
          }`}
          aria-current={lang === 'en' ? 'true' : undefined}
        >
          EN
        </a>
      </div>

      <button
        class="flex flex-col justify-center items-center gap-1.5 bg-transparent border-none cursor-pointer p-2 rounded-lg focus:outline-none focus:ring-2 focus:ring-white/40"
        id="hamburger"
        aria-label={lang === 'en' ? 'Open navigation menu' : 'Abrir menú de navegación'}
        aria-expanded="false"
      >
        <span class="block w-6 h-0.5 bg-white rounded-full"></span>
        <span class="block w-6 h-0.5 bg-white rounded-full"></span>
        <span class="block w-6 h-0.5 bg-white rounded-full"></span>
      </button>
    </div>
  </div>
</nav>
