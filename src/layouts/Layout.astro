	<body>
		<slot />

		<script>
			// Navbar Scroll Effect
			const navbar = document.getElementById('navbar');
			if (navbar) {
				window.addEventListener('scroll', () => {
					const scrolled = window.scrollY > 50;
					navbar.classList.toggle('bg-[#063350]/98', scrolled);
					navbar.classList.toggle('shadow-lg', scrolled);
					navbar.classList.toggle('py-2', scrolled);
					navbar.classList.toggle('py-4', !scrolled);
				}, { passive: true });
			}

			// Mobile Menu Toggle – menú desplegable mejorado
			const hamburger = document.getElementById('hamburger');
			const navLinks = document.getElementById('navLinks');
			let menuOpen = false;

			function openMenu() {
				menuOpen = true;
				navLinks!.classList.remove('hidden');
				navLinks!.classList.add('flex', 'flex-col', 'absolute', 'top-full', 'left-0', 'right-0', 'bg-[#0A4B75]', 'px-6', 'py-4', 'gap-1', 'shadow-xl', 'border-t', 'border-white/10');
				hamburger!.setAttribute('aria-expanded', 'true');
			}
			function closeMenu() {
				menuOpen = false;
				navLinks!.classList.add('hidden');
				navLinks!.classList.remove('flex', 'flex-col', 'absolute', 'top-full', 'left-0', 'right-0', 'bg-[#0A4B75]', 'px-6', 'py-4', 'gap-1', 'shadow-xl', 'border-t', 'border-white/10');
				hamburger!.setAttribute('aria-expanded', 'false');
			}

			if (hamburger && navLinks) {
				hamburger.addEventListener('click', (e) => {
					e.stopPropagation();
					menuOpen ? closeMenu() : openMenu();
				});
				navLinks.querySelectorAll('a').forEach(link => {
					link.addEventListener('click', closeMenu);
				});
				// Cerrar al hacer clic fuera del menú
				document.addEventListener('click', (e) => {
					if (menuOpen && !navLinks.contains(e.target as Node) && !hamburger.contains(e.target as Node)) {
						closeMenu();
					}
				});
				// Cerrar con ESC
				document.addEventListener('keydown', (e) => {
					if (e.key === 'Escape' && menuOpen) closeMenu();
				});
			}

			// Asegurar que al cargar la página sin hash el scroll inicie en el tope
			if (!window.location.hash && window.scrollY > 0) {
				window.scrollTo(0, 0);
			}

			// Scroll Reveal con IntersectionObserver (Suave y con rendimiento optimizado)
			const revealObserver = new IntersectionObserver((entries) => {
				entries.forEach(entry => {
					if (entry.isIntersecting) {
						entry.target.classList.add('reveal-visible');
						(entry.target as HTMLElement).style.opacity = '1';
						(entry.target as HTMLElement).style.transform = 'translate(0, 0) scale(1)';
						revealObserver.unobserve(entry.target);
					}
				});
			}, { threshold: 0.08, rootMargin: '0px 0px -40px 0px' });

			document.querySelectorAll('.reveal-init, .reveal-left, .reveal-right, .reveal-scale, .reveal-elem').forEach(el => {
				revealObserver.observe(el);
			});

			// WebMCP Tools Registration para Agentes en el Navegador
			try {
				const modelCtx = (navigator as any).modelContext;
				if (modelCtx && typeof modelCtx.registerTool === 'function') {
					modelCtx.registerTool({
						name: 'solicitar_cotizacion_renaval',
						description: 'Envía una solicitud formal de cotización de ingeniería a gerencia@renaval.com',
						inputSchema: {
							type: 'object',
							properties: {
								nombre: { type: 'string', description: 'Nombre completo del solicitante' },
								empresa: { type: 'string', description: 'Empresa u organización' },
								telefono: { type: 'string', description: 'Teléfono de contacto' },
								email: { type: 'string', description: 'Correo electrónico de contacto' },
								servicio: { 
									type: 'string', 
									enum: [
										'Asesoría para Proyectos',
										'Diseño y Fabricación Metalmecánica',
										'Montajes Estructurales',
										'Mantenimiento de Válvulas',
										'Mantenimiento Equipos Rotativos',
										'Montajes y Mantenimiento HVAC',
										'Pintura y Sandblasting',
										'Ingeniería Civil'
									] 
								},
								mensaje: { type: 'string', description: 'Descripción o requerimiento del proyecto' }
							},
							required: ['nombre', 'telefono', 'email', 'servicio', 'mensaje']
						},
						execute: async (args: any) => {
							const res = await fetch('https://formsubmit.co/ajax/gerencia@renaval.com', {
								method: 'POST',
								headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
								body: JSON.stringify({
									_subject: `WebMCP: ${args.servicio} - ${args.nombre}`,
									_template: 'table',
									_captcha: 'false',
									'Nombre': args.nombre,
									'Empresa': args.empresa || 'N/A',
									'Teléfono': args.telefono,
									'Correo': args.email,
									'Servicio': args.servicio,
									'Mensaje': args.mensaje
								})
							});
							return { success: res.ok, message: 'Cotización recibida exitosamente en gerencia@renaval.com' };
						}
					});

					modelCtx.registerTool({
						name: 'consultar_servicios_renaval',
						description: 'Retorna el catálogo oficial de servicios de ReNaval, normas aplicables (ISO 9001, AWS D1.1, PMI, IACS) y canales de contacto.',
						inputSchema: { type: 'object', properties: {} },
						execute: async () => {
							return {
								empresa: 'ReNaval – Soluciones Integrales de Ingeniería',
								correo: 'gerencia@renaval.com',
								telefono: '+57 311 335 6201 / +57 320 541 9121',
								servicios: [
									'Asesoría para Proyectos (PMI)',
									'Diseño y Fabricación Metalmecánica (AWS D1.1)',
									'Montajes Estructurales',
									'Mantenimiento y Recuperación de Válvulas',
									'Mantenimiento de Equipos Rotativos',
									'Montajes y Mantenimiento HVAC',
									'Pintura y Sandblasting (SSPC/NACE)',
									'Ingeniería Civil Portuaria e Industrial'
								],
								certificaciones: ['ISO 9001:2015', 'AWS D1.1-D1.7', 'PMI', 'IACS']
							};
						}
					});
				}
			} catch (e) {
				console.warn('WebMCP initialization note:', e);
			}
		</script>

		<!-- WhatsApp Floating Button -->
