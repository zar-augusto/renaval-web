---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
---

<Layout
  lang="en"
  title="Contact Us & Request a Quote – ReNaval"
  description="Contact ReNaval engineering management for marine repair, metal fabrication, and industrial quotes. Direct WhatsApp and official email."
  canonical="https://renaval.com/en/contact/"
>
  <Navbar lang="en" />

  <main class="min-h-screen bg-[#F8FAFC] pt-28 pb-20">
    <div class="max-w-[1100px] mx-auto px-4 sm:px-6">
      <!-- Breadcrumb -->
      <nav class="text-xs text-slate-500 mb-6 flex items-center gap-2" aria-label="Breadcrumb">
        <a href="/en/" class="hover:text-[#0A4B75] no-underline">Home</a>
        <span>/</span>
        <span class="text-[#0A4B75] font-semibold">Contact</span>
      </nav>

      <div class="text-center mb-10">
        <div class="inline-block text-[0.78rem] font-bold uppercase tracking-widest text-[#00A3E0] bg-[#00A3E0]/10 border border-[#00A3E0]/20 px-4 py-1.5 rounded-full mb-3">
          Official Support
        </div>
        <h1 class="text-3xl sm:text-4xl font-extrabold text-[#2D3137] mb-3">
          Direct Contact & Engineering Quotes
        </h1>
        <p class="text-slate-600 max-w-xl mx-auto text-base">
          Get in touch with our engineering project management for quote requests, afloat technical surveys, or emergency shipyard repairs.
        </p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <!-- Info Card -->
        <div class="bg-gradient-to-br from-[#063350] to-[#0A4B75] rounded-2xl p-8 text-white shadow-md flex flex-col justify-between">
          <div>
            <div class="w-16 h-16 bg-white/10 rounded-full flex items-center justify-center text-2xl font-bold mb-4 border border-white/20">RN</div>
            <h2 class="text-xl font-bold mb-1">ReNaval</h2>
            <p class="text-[#00A3E0] text-sm font-semibold mb-6">Comprehensive Engineering Solutions</p>
            
            <div class="space-y-4 text-sm">
              <div>
                <span class="block text-white/50 text-xs">Official Email</span>
                <a href="mailto:gerencia@renaval.com" class="text-white font-semibold hover:text-[#00A3E0] transition-colors break-all no-underline">
                  gerencia@renaval.com
                </a>
              </div>
              <div>
                <span class="block text-white/50 text-xs">Direct Line / WhatsApp</span>
                <a href="https://wa.me/573113356201" class="text-white font-semibold hover:text-[#25D366] transition-colors no-underline flex items-center gap-1.5" target="_blank" rel="noopener noreferrer">
                  <span>+57 311 335 6201</span>
                </a>
              </div>
              <div>
                <span class="block text-white/50 text-xs">Secondary Technical Line</span>
                <a href="tel:+573205419121" class="text-white font-semibold hover:text-[#00A3E0] transition-colors no-underline">
                  +57 320 541 9121
                </a>
              </div>
              <div>
                <span class="block text-white/50 text-xs">Project Manager</span>
                <strong class="text-white">Bayron Bartelemy</strong>
              </div>
              <div>
                <span class="block text-white/50 text-xs">Location & Domicile</span>
                <span class="text-white/80 block">Port & Industrial Zone, Barranquilla, Colombia</span>
                <span class="text-xs text-[#00A3E0] block mt-0.5">Maritime & riverine coverage in Cartagena, Barranquilla, Santa Marta, and Buenaventura</span>
              </div>
            </div>
          </div>

          <div class="mt-8 pt-6 border-t border-white/15">
            <span class="text-xs text-white/60 block mb-2">Operating Hours</span>
            <span class="text-xs font-semibold text-white">Monday to Saturday: 7:00 AM – 6:00 PM (COT)</span>
            <span class="text-[0.72rem] text-[#F2B800] block mt-1">24/7 availability for emergency afloat repairs</span>
          </div>
        </div>

        <!-- Form -->
        <div class="lg:col-span-2 bg-white border border-[#e2e8f0] rounded-2xl p-6 sm:p-8 shadow-sm">
          <h2 class="text-xl font-bold text-[#2D3137] mb-2">Submit Your Inquiry</h2>
          <p class="text-sm text-slate-500 mb-6">Complete the form and our technical team will respond with a preliminary assessment.</p>

          <form id="contactFormDedicatedEn" action="https://formsubmit.co/gerencia@renaval.com" method="POST" class="flex flex-col gap-4">
            <input type="text" name="_honeypot" style="display:none" tabindex="-1" autocomplete="off">
            <input type="hidden" name="_subject" value="New Inquiry - ReNaval English Contact Page">
            <input type="hidden" name="_template" value="table">
            <input type="hidden" name="_captcha" value="false">

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="nombre" class="block text-xs font-bold text-slate-700 uppercase mb-1.5">Full Name *</label>
                <input type="text" id="nombre" name="nombre" required placeholder="e.g. Capt. Mark Stevens" class="w-full px-3.5 py-2.5 text-sm rounded-lg border border-slate-300 focus:border-[#0A4B75] focus:ring-1 focus:ring-[#0A4B75] outline-none">
              </div>
              <div>
                <label for="empresa" class="block text-xs font-bold text-slate-700 uppercase mb-1.5">Company / Vessel</label>
                <input type="text" id="empresa" name="empresa" placeholder="e.g. Pacific Bulk Carriers" class="w-full px-3.5 py-2.5 text-sm rounded-lg border border-slate-300 focus:border-[#0A4B75] focus:ring-1 focus:ring-[#0A4B75] outline-none">
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="telefono" class="block text-xs font-bold text-slate-700 uppercase mb-1.5">Phone / WhatsApp *</label>
                <input type="tel" id="telefono" name="telefono" required placeholder="+1 (305) 555-0199" class="w-full px-3.5 py-2.5 text-sm rounded-lg border border-slate-300 focus:border-[#0A4B75] focus:ring-1 focus:ring-[#0A4B75] outline-none">
              </div>
              <div>
                <label for="email" class="block text-xs font-bold text-slate-700 uppercase mb-1.5">Email *</label>
                <input type="email" id="email" name="email" required placeholder="m.stevens@company.com" class="w-full px-3.5 py-2.5 text-sm rounded-lg border border-slate-300 focus:border-[#0A4B75] focus:ring-1 focus:ring-[#0A4B75] outline-none">
              </div>
            </div>

            <div>
              <label for="servicio" class="block text-xs font-bold text-slate-700 uppercase mb-1.5">Service of Interest *</label>
              <select id="servicio" name="servicio" required class="w-full px-3.5 py-2.5 text-sm rounded-lg border border-slate-300 focus:border-[#0A4B75] focus:ring-1 focus:ring-[#0A4B75] outline-none bg-white">
                <option value="" disabled selected>Select an engineering service...</option>
                <option value="Project Advisory & Management (PMI)">Project Advisory & Management (PMI)</option>
                <option value="Heavy Metal Fabrication (AWS D1.1)">Heavy Metal Fabrication (AWS D1.1)</option>
                <option value="Structural Assembly & Erection">Structural Assembly & Erection</option>
                <option value="Industrial Valve Overhaul">Industrial Valve Overhaul</option>
                <option value="Rotating Equipment & Laser Alignment">Rotating Equipment & Laser Alignment</option>
                <option value="Marine & Industrial HVAC Systems">Marine & Industrial HVAC Systems</option>
                <option value="Surface Preparation & Sandblasting (SSPC/NACE)">Surface Preparation & Sandblasting (SSPC/NACE)</option>
                <option value="Civil Engineering & Port Infrastructure">Civil Engineering & Port Infrastructure</option>
              </select>
            </div>

            <div>
              <label for="mensaje" class="block text-xs font-bold text-slate-700 uppercase mb-1.5">Project Scope / Message *</label>
              <textarea id="mensaje" name="mensaje" rows="4" required placeholder="Describe technical specifications, vessel/plant location, and target schedule..." class="w-full px-3.5 py-2.5 text-sm rounded-lg border border-slate-300 focus:border-[#0A4B75] focus:ring-1 focus:ring-[#0A4B75] outline-none resize-none"></textarea>
            </div>

            <button type="submit" id="btnDedicatedEn" class="bg-[#0A4B75] hover:bg-[#063350] text-white font-bold py-3.5 px-6 rounded-lg transition-colors cursor-pointer text-sm">
              Send Request
            </button>

            <div id="msgSuccessDedicatedEn" class="hidden p-4 bg-emerald-50 border border-emerald-200 rounded-lg text-emerald-800 text-sm">
              ✓ Inquiry submitted successfully. We will reach back to you shortly.
            </div>
            <div id="msgErrorDedicatedEn" class="hidden p-4 bg-rose-50 border border-rose-200 rounded-lg text-rose-800 text-sm">
              Submission error. Please email us directly at gerencia@renaval.com.
            </div>
          </form>
        </div>
      </div>
    </div>
  </main>

  <Footer lang="en" />

  <script>
    const f = document.getElementById('contactFormDedicatedEn') as HTMLFormElement;
    const s = document.getElementById('msgSuccessDedicatedEn');
    const err = document.getElementById('msgErrorDedicatedEn');
    const b = document.getElementById('btnDedicatedEn') as HTMLButtonElement;

    if (f) {
      f.addEventListener('submit', async (e) => {
        e.preventDefault();
        const fd = new FormData(f);
        const data = Object.fromEntries(fd.entries());

        if (data._honeypot) {
          if (s) s.classList.remove('hidden');
          f.reset();
          return;
        }

        if (b) {
          b.disabled = true;
          b.innerText = 'Sending...';
        }

        try {
          const res = await fetch('https://formsubmit.co/ajax/gerencia@renaval.com', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
            body: JSON.stringify({
              _subject: `Contact Page Inquiry: ${data.servicio} - ${data.nombre}`,
              _template: 'table',
              _captcha: 'false',
              Name: data.nombre,
              Company: data.empresa || 'N/A',
              Phone: data.telefono,
              Email: data.email,
              Service: data.servicio,
              Message: data.mensaje
            })
          });

          if (res.ok) {
            if (s) s.classList.remove('hidden');
            if (err) err.classList.add('hidden');
            f.reset();
          } else {
            throw new Error('Error in submission');
          }
        } catch {
          if (err) err.classList.remove('hidden');
        } finally {
          if (b) {
            b.disabled = false;
            b.innerText = 'Send Request';
          }
        }
      });
    }
  </script>
</Layout>
