  <script>
    import { supabase } from "../../lib/supabase";

    const form = document.getElementById("contactForm") as HTMLFormElement;
    const successMsg = document.getElementById("formSuccess");
    const errorMsg = document.getElementById("formError");
    const submitBtn = document.getElementById("submitBtn") as HTMLButtonElement;

    if (form) {
      form.addEventListener("submit", async (e) => {
        e.preventDefault();

        const formData = new FormData(form);
        const data = Object.fromEntries(formData.entries());

        // Honeypot check
        if (data._honeypot) {
          // If honeypot is filled, it's a bot. Just show success to trick it.
          if (successMsg) successMsg.classList.remove("hidden");
          form.reset();
          return;
        }

        if (submitBtn) {
          submitBtn.disabled = true;
          submitBtn.innerHTML = "Sending quote...";
        }

        try {
          // Envío directo al correo gerencia@renaval.com vía FormSubmit AJAX
          const response = await fetch(
            "https://formsubmit.co/ajax/gerencia@renaval.com",
            {
              method: "POST",
              headers: {
                "Content-Type": "application/json",
                Accept: "application/json",
              },
              body: JSON.stringify({
                _subject: `New ReNaval Quote Request (EN): ${data.servicio} (${data.nombre})`,
                _template: "table",
                _captcha: "false",
                "Client Name": data.nombre,
                Company: data.empresa || "Not specified",
                Phone: data.telefono,
                "Requester Email": data.email,
                "Service of Interest": data.servicio,
                "Project Description": data.mensaje,
              }),
            },
          );

          // Registro complementario en base de datos si Supabase está activo
          try {
            await supabase.from("contactos").insert([
              {
                nombre: data.nombre,
                empresa: data.empresa || "",
                telefono: data.telefono,
                email: data.email,
                servicio: data.servicio,
                mensaje: data.mensaje,
              },
            ]);
          } catch (dbErr) {
            console.warn(
              "Registro complementario en base de datos opcional:",
              dbErr,
            );
          }

          if (response.ok) {
            if (successMsg) successMsg.classList.remove("hidden");
            if (errorMsg) errorMsg.classList.add("hidden");
            form.reset();
          } else {
            throw new Error("Could not complete email submission");
          }
        } catch (error) {
          console.error("Error al enviar:", error);
          if (errorMsg) errorMsg.classList.remove("hidden");
          if (successMsg) successMsg.classList.add("hidden");
        } finally {
          if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.innerHTML = "Submit Request &rarr;";
          }
        }
      });
    }
  </script>
