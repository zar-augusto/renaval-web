  </section>

  <!-- CTA STRIP -->
  <section class="relative py-16 sm:py-20 overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-br from-[#063350] via-[#0A4B75] to-[#041c2c]"></div>
    <div class="absolute inset-0 bg-[url('/images/PHOTO-2026-09-25-07-16-04.webp')] bg-center bg-cover bg-no-repeat opacity-35"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-[#063350] via-[#063350]/75 to-[#063350]/80"></div>

    <div class="relative max-w-[900px] mx-auto px-4 sm:px-6 text-center reveal-scale">
      <div class="inline-flex items-center justify-center w-12 h-12 sm:w-14 sm:h-14 rounded-full bg-[#F2B800]/15 border border-[#F2B800]/30 mb-5 sm:mb-6">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 sm:w-7 sm:h-7 text-[#F2B800]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
