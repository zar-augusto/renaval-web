  <script>
    (function () {
      const GALLERY = [
        {
          src: "/images/PHOTO-2026-09-25-07-15-52.webp",
          label: "Naval Welding",
          desc: "Certified welding on vessel hull plating under AWS standards",
        },
        {
          src: "/images/PHOTO-2026-09-25-07-15-52 2.webp",
          label: "Steel Structures",
          desc: "Fabrication and fit-up of interior metallic structural modules",
        },
        {
          src: "/images/PHOTO-2026-09-25-07-16-05 2.webp",
          label: "Machinery Overhaul",
          desc: "ReNaval field engineer inspecting engine room machinery",
        },
        {
          src: "/images/PHOTO-2026-09-25-07-16-02.webp",
          label: "Deck Operations",
          desc: "Certified welder executing structural marine deck modifications",
        },
        {
          src: "/images/PHOTO-2026-09-25-07-15-56 2.webp",
          label: "Marine Fabrication",
          desc: "Fabricated, assembled, and coated marine steel structure",
        },
        {
          src: "/images/PHOTO-2026-09-25-07-16-05 4.webp",
          label: "Valve Maintenance",
          desc: "Industrial and marine valves fully overhauled and tested",
        },
        {
          src: "/images/PHOTO-2026-09-25-07-15-55.webp",
          label: "Hull Repairs",
          desc: "Shipyard slipway structural hull repair and plate renewal",
        },
        {
          src: "/images/PHOTO-2026-09-25-07-16-01.jpg",
          label: "Industrial Piping",
          desc: "Precision stainless steel process and fuel piping systems",
        },
        {
          src: "/images/PHOTO-2026-09-25-07-16-05.webp",
          label: "Valve Overhaul",
          desc: "High-pressure valve certified and coated after hydrostatic test",
        },
        {
          src: "/images/PHOTO-2026-09-25-07-15-56.webp",
          label: "Anticorrosive Coating",
          desc: "Epoxy marine anticorrosive system applied to ship hull",
        },
        {
          src: "/images/PHOTO-2026-09-25-07-16-04.webp",
          label: "Quayside Repairs",
          desc: "Afloat welding and technical interventions at operational dock",
        },
        {
          src: "/images/PHOTO-2026-09-25-07-16-04 4.jpg",
          label: "Aluminum Fabrication",
          desc: "Marine-grade aluminum gangway and structural vessel accesses",
        },
      ];

      let idx = 0;
      let lbOpen = false;

      const cImg = document.getElementById("carousel-img") as HTMLImageElement;
      const cMain = document.getElementById("carousel-main");
      const thumbs = document.getElementById("carousel-thumbs");
      const dots = document.getElementById("carousel-dots");
      const zoomBtn = document.getElementById("carousel-zoom-btn");

      const lb = document.getElementById("lightbox");
      const lbImg = document.getElementById("lb-img") as HTMLImageElement;
      const lbClose = document.getElementById("lb-close");
      const lbPrev = document.getElementById("lb-prev");
      const lbNext = document.getElementById("lb-next");

      if (!cImg || !thumbs || !dots) return;

      GALLERY.forEach(function (item, i) {
        // Thumbnail
        var t = document.createElement("button");
        t.type = "button";
        t.className =
          "flex-shrink-0 w-16 h-12 sm:w-20 sm:h-16 rounded-lg overflow-hidden border-2 transition-all cursor-pointer focus:outline-none " +
          (i === 0
            ? "border-[#00A3E0] opacity-100 scale-105"
            : "border-transparent opacity-55 hover:opacity-85");
        t.setAttribute("aria-label", "View " + item.label);
        t.innerHTML =
          '<img src="' +
          item.src +
          '" alt="' +
          item.label +
          '" class="w-full h-full object-cover pointer-events-none" loading="lazy" />';
        t.addEventListener("click", function (e) {
          e.preventDefault();
          goTo(i);
        });
        thumbs.appendChild(t);

        // Dot
        var d = document.createElement("button");
        d.type = "button";
        d.className =
          "rounded-full border-none cursor-pointer focus:outline-none transition-all";
        d.style.cssText =
          "height:8px;background:" +
          (i === 0 ? "#00A3E0" : "#cbd5e1") +
          ";width:" +
          (i === 0 ? "24" : "8") +
          "px;";
        d.setAttribute("aria-label", "Photo " + (i + 1));
        d.addEventListener("click", function (e) {
          e.preventDefault();
          goTo(i);
        });
        dots.appendChild(d);
      });

      function goTo(n: number) {
        idx = ((n % GALLERY.length) + GALLERY.length) % GALLERY.length;
        var item = GALLERY[idx];

        cImg.style.opacity = "0";
        setTimeout(function () {
          cImg.src = item.src;
          cImg.alt = item.desc;
          cImg.style.opacity = "1";
        }, 150);

        var allThumbs = thumbs!.querySelectorAll("button");
        allThumbs.forEach(function (t, i) {
          t.className =
            "flex-shrink-0 w-16 h-12 sm:w-20 sm:h-16 rounded-lg overflow-hidden border-2 transition-all cursor-pointer focus:outline-none " +
            (i === idx
              ? "border-[#00A3E0] opacity-100 scale-105"
              : "border-transparent opacity-55 hover:opacity-85");
          if (i === idx) {
            var tLeft = t.offsetLeft;
            var tWidth = t.offsetWidth;
            var cWidth = thumbs!.offsetWidth;
            thumbs!.scrollTo({
              left: tLeft - cWidth / 2 + tWidth / 2,
              behavior: "smooth",
            });
          }
        });

        dots!.querySelectorAll("button").forEach(function (d, i) {
          d.style.background = i === idx ? "#00A3E0" : "#cbd5e1";
          d.style.width = (i === idx ? 24 : 8) + "px";
        });

        if (lbOpen) syncLb();
      }

      function syncLb() {
        var item = GALLERY[idx];
        lbImg.style.opacity = "0";
        setTimeout(function () {
          lbImg.src = item.src;
          lbImg.alt = item.desc;
          lbImg.style.opacity = "1";
        }, 120);
      }

      function openLb() {
        syncLb();
        lb!.style.opacity = "1";
        lb!.style.pointerEvents = "all";
        document.body.style.overflow = "hidden";
        lbOpen = true;
      }

      function closeLb() {
        lb!.style.opacity = "0";
        lb!.style.pointerEvents = "none";
        document.body.style.overflow = "";
        lbOpen = false;
      }

      document
        .getElementById("prev-btn")
        ?.addEventListener("click", function (e) {
          e.preventDefault();
          goTo(idx - 1);
        });

      document
        .getElementById("next-btn")
        ?.addEventListener("click", function (e) {
          e.preventDefault();
          goTo(idx + 1);
        });

      cMain?.addEventListener("click", function (e) {
        if ((e.target as HTMLElement).closest("#prev-btn, #next-btn")) return;
        openLb();
      });

      zoomBtn?.addEventListener("click", function (e) {
        e.stopPropagation();
        openLb();
      });

      lbClose?.addEventListener("click", closeLb);
      lbPrev?.addEventListener("click", function () {
        goTo(idx - 1);
      });
      lbNext?.addEventListener("click", function () {
        goTo(idx + 1);
      });

      lb?.addEventListener("click", function (e) {
        if (e.target === lb || (e.target as HTMLElement).closest(".flex-col") === null) {
          if (!(e.target as HTMLElement).closest("#lb-prev, #lb-next, #lb-img")) {
            closeLb();
          }
        }
      });

      document.addEventListener("keydown", function (e) {
        if (!lbOpen) return;
        if (e.key === "Escape") closeLb();
        if (e.key === "ArrowLeft") goTo(idx - 1);
        if (e.key === "ArrowRight") goTo(idx + 1);
      });
    })();
  </script>

