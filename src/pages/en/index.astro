  <script>
    (function () {
      const GALLERY = [
        {
          src: "/images/PHOTO-2026-09-25-07-15-52.webp",
          label: "Marine Welding",
          desc: "Hull welding on commercial vessel",
        },
        {
          src: "/images/PHOTO-2026-09-25-07-15-52 2.webp",
          label: "Steel Structures",
          desc: "Fabrication of interior structural steel frame",
        },
        {
          src: "/images/PHOTO-2026-09-25-07-16-05 2.webp",
          label: "Equipment Maintenance",
          desc: "ReNaval technician servicing engine room machinery",
        },
        {
          src: "/images/PHOTO-2026-09-25-07-16-02.webp",
          label: "Deck Operations",
          desc: "Certified welder working on deck plating",
        },
        {
          src: "/images/PHOTO-2026-09-25-07-15-56 2.webp",
          label: "Marine Fabrication",
          desc: "Marine structure fabricated and painted",
        },
        {
          src: "/images/PHOTO-2026-09-25-07-16-05 4.webp",
          label: "Valve Maintenance",
          desc: "Válvulas industriales restauradas",
        },
        {
          src: "/images/PHOTO-2026-09-25-07-15-55.webp",
          label: "Hull Repairs",
          desc: "Shipyard drydock hull steel repair",
        },
        {
          src: "/images/PHOTO-2026-09-25-07-16-01.jpg",
          label: "Industrial Piping",
          desc: "Custom stainless steel piping spools",
        },
        {
          src: "/images/PHOTO-2026-09-25-07-16-05.webp",
          label: "Valve Overhaul",
          desc: "Industrial valve overhauled, painted, and certified",
        },
        {
          src: "/images/PHOTO-2026-09-25-07-15-56.webp",
          label: "Coatings Anticorrosiva",
          desc: "Coatings anticorrosiva en casco de embarcación",
        },
        {
          src: "/images/PHOTO-2026-09-25-07-16-04.webp",
          label: "Quayside Works",
          desc: "Quayside afloat welding and structural repairs",
        },
        {
          src: "/images/PHOTO-2026-09-25-07-16-04 4.jpg",
          label: "Aluminum Fabrication",
          desc: "Marine-grade aluminum boarding gangway",
        },
      ];

      let idx = 0;
      let lbOpen = false;

      const cImg = document.getElementById("carousel-img");
      const thumbs = document.getElementById("carousel-thumbs");
      const dots = document.getElementById("carousel-dots");
      const lb = document.getElementById("lightbox");
      const lbImg = document.getElementById("lb-img");

      if (!cImg || !thumbs || !dots) return;

      // Construir miniaturas y dots con botones accesibles
      GALLERY.forEach(function (item, i) {
        var th = document.createElement("button");
        th.type = "button";
        th.className =
          "flex-shrink-0 w-16 h-12 sm:w-20 sm:h-16 rounded-lg overflow-hidden border-2 transition-all cursor-pointer focus:outline-none " +
          (i === 0
            ? "border-[#00A3E0] opacity-100 scale-105"
            : "border-transparent opacity-55 hover:opacity-85");
        th.setAttribute("aria-label", item.label);
        th.innerHTML =
          '<img src="' +
          item.src +
          '" alt="' +
          item.label +
          '" class="w-full h-full object-cover pointer-events-none" loading="lazy"/>';
        th.addEventListener("click", function (e) {
          e.preventDefault();
          goTo(i);
        });
        thumbs.appendChild(th);

        var d = document.createElement("button");
        d.type = "button";
        d.className =
          "rounded-full border-none cursor-pointer focus:outline-none transition-all";
        d.style.cssText =
          "height:8px;background:" +
          (i === 0 ? "#00A3E0" : "#cbd5e1") +
          ";width:" +
          (i === 0 ? "24" : "8") +
          "px;";
        d.setAttribute("aria-label", "Photo " + (i + 1));
        d.addEventListener("click", function (e) {
          e.preventDefault();
          goTo(i);
        });
        dots.appendChild(d);
      });

      function goTo(n) {
        idx = ((n % GALLERY.length) + GALLERY.length) % GALLERY.length;
        var item = GALLERY[idx];

        cImg.style.opacity = "0";
        setTimeout(function () {
          cImg.src = item.src;
          cImg.alt = item.desc;
          cImg.style.opacity = "1";
        }, 150);

        var allThumbs = thumbs.querySelectorAll("button");
        allThumbs.forEach(function (t, i) {
          t.className =
            "flex-shrink-0 w-16 h-12 sm:w-20 sm:h-16 rounded-lg overflow-hidden border-2 transition-all cursor-pointer focus:outline-none " +
            (i === idx
              ? "border-[#00A3E0] opacity-100 scale-105"
              : "border-transparent opacity-55 hover:opacity-85");
          if (i === idx) {
            // Desplazar estrictamente el contenedor horizontal de miniaturas (sin mover el scroll de la página)
            var tLeft = t.offsetLeft;
            var tWidth = t.offsetWidth;
            var cWidth = thumbs.offsetWidth;
            thumbs.scrollTo({
              left: tLeft - cWidth / 2 + tWidth / 2,
              behavior: "smooth",
            });
          }
        });

        dots.querySelectorAll("button").forEach(function (d, i) {
          d.style.background = i === idx ? "#00A3E0" : "#cbd5e1";
          d.style.width = (i === idx ? 24 : 8) + "px";
        });

        if (lbOpen) syncLb();
      }

      function syncLb() {
        var item = GALLERY[idx];
        lbImg.style.opacity = "0";
        setTimeout(function () {
          lbImg.src = item.src;
          lbImg.alt = item.desc;
          lbImg.style.opacity = "1";
        }, 120);
      }

      function openLb() {
        syncLb();
        lb.style.opacity = "1";
        lb.style.pointerEvents = "all";
        document.body.style.overflow = "hidden";
        lbOpen = true;
      }

      function closeLb() {
        lb.style.opacity = "0";
        lb.style.pointerEvents = "none";
        document.body.style.overflow = "";
        lbOpen = false;
      }

      // Controles manuales del carrusel (100% control del usuario, sin temporizadores automáticos)
      document
        .getElementById("prev-btn")
        .addEventListener("click", function (e) {
          e.preventDefault();
          e.stopPropagation();
          goTo(idx - 1);
        });
      document
        .getElementById("next-btn")
        .addEventListener("click", function (e) {
          e.preventDefault();
          e.stopPropagation();
          goTo(idx + 1);
        });
      document
        .getElementById("carousel-main")
        .addEventListener("click", openLb);
      document
        .getElementById("carousel-zoom-btn")
        .addEventListener("click", function (e) {
          e.preventDefault();
          e.stopPropagation();
          openLb();
        });

      // Swipe táctil en móvil para carrusel
      var tsx = 0;
      var tsy = 0;
      var cs = document.getElementById("carousel-main");
      cs.addEventListener(
        "touchstart",
        function (e) {
          tsx = e.touches[0].clientX;
          tsy = e.touches[0].clientY;
        },
        { passive: true },
      );
      cs.addEventListener(
        "touchend",
        function (e) {
          var dx = tsx - e.changedTouches[0].clientX;
          var dy = tsy - e.changedTouches[0].clientY;
          if (Math.abs(dx) > 40 && Math.abs(dx) > Math.abs(dy)) {
            goTo(dx > 0 ? idx + 1 : idx - 1);
          }
        },
        { passive: true },
      );

      // Controles lightbox
      document.getElementById("lb-close").addEventListener("click", closeLb);
      document
        .getElementById("lb-prev")
        .addEventListener("click", function (e) {
          e.stopPropagation();
          goTo(idx - 1);
        });
      document
        .getElementById("lb-next")
        .addEventListener("click", function (e) {
          e.stopPropagation();
          goTo(idx + 1);
        });
      lb.addEventListener("click", function (e) {
        if (e.target === lb) closeLb();
      });

      document.addEventListener("keydown", function (e) {
        if (!lbOpen) return;
        if (e.key === "Escape") closeLb();
        if (e.key === "ArrowLeft") goTo(idx - 1);
        if (e.key === "ArrowRight") goTo(idx + 1);
      });

      // Swipe táctil en lightbox
      var lbx = 0;
      var lby = 0;
      lb.addEventListener(
        "touchstart",
        function (e) {
          lbx = e.touches[0].clientX;
          lby = e.touches[0].clientY;
        },
        { passive: true },
      );
      lb.addEventListener(
        "touchend",
        function (e) {
          var dx = lbx - e.changedTouches[0].clientX;
          var dy = lby - e.changedTouches[0].clientY;
          if (Math.abs(dx) > 40 && Math.abs(dx) > Math.abs(dy)) {
            goTo(dx > 0 ? idx + 1 : idx - 1);
          }
        },
        { passive: true },
      );
    })();
  </script>

