  <script>
    import { supabase } from "../../lib/supabase";

    const form = document.getElementById("contactForm") as HTMLFormElement;
    const successMsg = document.getElementById("formSuccess");
    const errorMsg = document.getElementById("formError");
    const submitBtn = document.getElementById("submitBtn") as HTMLButtonElement;

    if (form) {
      form.addEventListener("submit", async (e) => {
        e.preventDefault();

        const formData = new FormData(form);
        const data = Object.fromEntries(formData.entries());

        // Honeypot check
        if (data._honeypot) {
          if (successMsg) successMsg.classList.remove("hidden");
          form.reset();
          return;
        }

        // Disable button during submission
        if (submitBtn) {
          submitBtn.disabled = true;
          submitBtn.innerText = "Submitting...";
        }

        try {
          // 1. Guardar en Supabase (si está configurado)
          let supabaseError = false;
          try {
            const { error } = await supabase
              .from("cotizaciones")
              .insert([
                {
                  nombre: data.nombre,
                  empresa: data.empresa || null,
                  telefono: data.telefono,
                  email: data.email,
                  servicio: data.servicio,
                  mensaje: data.mensaje,
                },
              ]);
            if (error) supabaseError = true;
          } catch (err) {
            supabaseError = true;
          }

          // 2. Enviar por FormSubmit.co
          const res = await fetch("https://formsubmit.co/ajax/gerencia@renaval.com", {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
              Accept: "application/json",
            },
            body: JSON.stringify({
              _subject: `New RFP (English): ${data.servicio} - ${data.nombre}`,
              _template: "table",
              _captcha: "false",
              Name: data.nombre,
              Company: data.empresa || "N/A",
              Phone: data.telefono,
              Email: data.email,
              Service: data.servicio,
              Message: data.mensaje,
            }),
          });

          if (res.ok) {
            if (successMsg) successMsg.classList.remove("hidden");
            if (errorMsg) errorMsg.classList.add("hidden");
            form.reset();
          } else {
            throw new Error("FormSubmit failed");
          }
        } catch (err) {
          console.error("Form error:", err);
          if (errorMsg) errorMsg.classList.remove("hidden");
          if (successMsg) successMsg.classList.add("hidden");
        } finally {
          if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.innerText = "Submit Quote Request →";
          }
        }
      });
    }
  </script>
