      <a
        href="https://wa.me/573113356201?text=Hello%20ReNaval%2C%20I%20would%20like%20to%20request%20an%20engineering%20quote."
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-3 bg-[#25D366] hover:bg-[#1ebe5c] text-white font-bold text-base px-8 py-4 rounded-xl shadow-lg hover:shadow-xl transition-all duration-300 hover:scale-105 no-underline"
      >
        <span>{t.cta.whatsappBtn}</span>
      </a>
    </div>
