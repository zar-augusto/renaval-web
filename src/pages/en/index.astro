  <!-- FOOTER -->
  <Footer lang="en" />

  <script>
    // Carousel logic for English view
    (function () {
      const GALLERY = [
        { src: '/images/PHOTO-2026-09-25-07-15-52.webp', label: 'Marine Welding', desc: 'Hull structural welding certified under AWS naval standards' },
        { src: '/images/PHOTO-2026-09-25-07-15-52 2.webp', label: 'Steel Structures', desc: 'Fabrication and custom fit-up of interior steel structure' },
        { src: '/images/PHOTO-2026-09-25-07-16-05 2.webp', label: 'Machinery Overhaul', desc: 'Engine room technical inspection and mechanical service' },
        { src: '/images/PHOTO-2026-09-25-07-16-02.webp', label: 'Deck Operations', desc: 'ReNaval certified welder executing deck modifications' },
        { src: '/images/PHOTO-2026-09-25-07-15-56 2.webp', label: 'Marine Fabrication', desc: 'Custom marine structure fabricated, assembled, and coated' },
        { src: '/images/PHOTO-2026-09-25-07-16-05 4.webp', label: 'Valve Maintenance', desc: 'Overhauled and pressure-tested industrial marine valves' },
        { src: '/images/PHOTO-2026-09-25-07-15-55.webp', label: 'Hull Repairs', desc: 'Shipyard drydock structural hull repair and plating replacement' },
        { src: '/images/PHOTO-2026-09-25-07-16-01.jpg', label: 'Industrial Piping', desc: 'Custom stainless steel process piping spools' },
        { src: '/images/PHOTO-2026-09-25-07-16-05.webp', label: 'Valve Overhaul', desc: 'High-pressure valve fully restored, tested, and certified' },
        { src: '/images/PHOTO-2026-09-25-07-15-56.webp', label: 'Anticorrosive Coating', desc: 'Multi-layer marine protective coating applied to hull' },
        { src: '/images/PHOTO-2026-09-25-07-16-04.webp', label: 'Quayside Repairs', desc: 'Specialized afloat welding and repairs at operational berth' },
        { src: '/images/PHOTO-2026-09-25-07-16-04 4.jpg', label: 'Aluminum Fabrication', desc: 'Marine-grade aluminum gangway and structural access fabrication' }
      ];

      let idx = 0;
      const cImg = document.getElementById('carousel-img') as HTMLImageElement;
      const thumbs = document.getElementById('carousel-thumbs');
      const prevBtn = document.getElementById('prev-btn');
      const nextBtn = document.getElementById('next-btn');

      if (!cImg || !thumbs) return;

      GALLERY.forEach((item, i) => {
        const btn = document.createElement('button');
        btn.className = `flex-shrink-0 w-16 h-12 sm:w-20 sm:h-14 rounded-lg overflow-hidden border-2 transition-all cursor-pointer focus:outline-none ${i === 0 ? 'border-[#00A3E0] opacity-100 scale-105' : 'border-transparent opacity-55 hover:opacity-85'}`;
        btn.setAttribute('aria-label', `Thumbnail ${i + 1}: ${item.label}`);
        btn.innerHTML = `<img src="${item.src}" alt="${item.label}" class="w-full h-full object-cover pointer-events-none" />`;
        btn.addEventListener('click', () => goTo(i));
        thumbs.appendChild(btn);
      });

      function goTo(n: number) {
        idx = ((n % GALLERY.length) + GALLERY.length) % GALLERY.length;
        const item = GALLERY[idx];
        cImg.style.opacity = '0';
        setTimeout(() => {
          cImg.src = item.src;
          cImg.alt = item.desc;
          cImg.style.opacity = '1';
        }, 150);

        thumbs?.querySelectorAll('button').forEach((t, i) => {
          t.className = `flex-shrink-0 w-16 h-12 sm:w-20 sm:h-14 rounded-lg overflow-hidden border-2 transition-all cursor-pointer focus:outline-none ${i === idx ? 'border-[#00A3E0] opacity-100 scale-105' : 'border-transparent opacity-55 hover:opacity-85'}`;
        });
      }

      prevBtn?.addEventListener('click', () => goTo(idx - 1));
      nextBtn?.addEventListener('click', () => goTo(idx + 1));

      // English Form handler
      const form = document.getElementById('contactFormEn') as HTMLFormElement;
      const successMsg = document.getElementById('formSuccessEn');
      const errorMsg = document.getElementById('formErrorEn');
      const submitBtn = document.getElementById('submitBtnEn') as HTMLButtonElement;

      if (form) {
        form.addEventListener('submit', async (e) => {
          e.preventDefault();
          const formData = new FormData(form);
          const data = Object.fromEntries(formData.entries());

          if (data._honeypot) {
            if (successMsg) successMsg.classList.remove('hidden');
            form.reset();
            return;
          }

          if (submitBtn) {
            submitBtn.disabled = true;
            submitBtn.innerText = 'Sending Request...';
          }

          try {
            const res = await fetch('https://formsubmit.co/ajax/gerencia@renaval.com', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
              body: JSON.stringify({
                _subject: `English Portal RFP: ${data.servicio} - ${data.nombre}`,
                _template: 'table',
                _captcha: 'false',
                Name: data.nombre,
                Company: data.empresa || 'N/A',
                Phone: data.telefono,
                Email: data.email,
                Service: data.servicio,
                Message: data.mensaje
              })
            });

            if (res.ok) {
              if (successMsg) successMsg.classList.remove('hidden');
              if (errorMsg) errorMsg.classList.add('hidden');
              form.reset();
            } else {
              throw new Error('Submission failed');
            }
          } catch {
            if (errorMsg) errorMsg.classList.remove('hidden');
          } finally {
            if (submitBtn) {
              submitBtn.disabled = false;
              submitBtn.innerText = 'Submit Quote Request';
            }
          }
        });
      }
    })();
  </script>
