---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <!-- NAVBAR -->
  <nav class="fixed top-0 left-0 right-0 z-50 py-4 bg-[#0A4B75]/95 backdrop-blur-md border-b border-white/10 transition-all duration-300" id="navbar">
    <div class="max-w-[1200px] mx-auto px-6 flex items-center justify-between">
      <a href="#inicio" class="flex items-center no-underline">
        <img src="/images/logo.png" alt="ReNaval Logo" class="h-11 w-auto object-contain" />
      </a>
      <ul class="hidden md:flex items-center gap-2 list-none" id="navLinks">
        <li><a href="#inicio" class="text-white/85 no-underline text-sm font-medium px-4 py-2 rounded-lg transition-colors hover:text-white hover:bg-white/10">Inicio</a></li>
        <li><a href="#nosotros" class="text-white/85 no-underline text-sm font-medium px-4 py-2 rounded-lg transition-colors hover:text-white hover:bg-white/10">Nosotros</a></li>
        <li><a href="#servicios" class="text-white/85 no-underline text-sm font-medium px-4 py-2 rounded-lg transition-colors hover:text-white hover:bg-white/10">Servicios</a></li>
        <li><a href="#experiencia" class="text-white/85 no-underline text-sm font-medium px-4 py-2 rounded-lg transition-colors hover:text-white hover:bg-white/10">Experiencia</a></li>
        <li><a href="#galeria" class="text-white/85 no-underline text-sm font-medium px-4 py-2 rounded-lg transition-colors hover:text-white hover:bg-white/10">Galería</a></li>
        <li><a href="#contacto" class="bg-[#F2B800] text-[#2D3137] font-bold rounded-lg px-4 py-2 transition-transform hover:-translate-y-px hover:bg-[#e0aa00]">Cotizar</a></li>
      </ul>
      <button class="md:hidden flex flex-col gap-1 bg-transparent border-none cursor-pointer p-1" id="hamburger" aria-label="Abrir menú">
        <span class="block w-6 h-0.5 bg-white rounded-full"></span>
        <span class="block w-6 h-0.5 bg-white rounded-full"></span>
        <span class="block w-6 h-0.5 bg-white rounded-full"></span>
      </button>
    </div>
  </nav>

  <!-- HERO -->
  <section class="min-h-screen bg-gradient-to-br from-[#063350] via-[#0A4B75] to-[#1a7ab5] flex items-center justify-center relative overflow-hidden pt-[100px] px-6 pb-[60px]" id="inicio">
    <div class="absolute inset-0 bg-[url('/images/hero-bg.png')] bg-center bg-cover bg-no-repeat opacity-12"></div>
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_70%_50%,rgba(0,163,224,0.15)_0%,transparent_60%)]"></div>
    <div class="absolute inset-0 bg-gradient-to-r from-[#063350]/70 to-transparent"></div>
    
    <div class="relative z-10 text-center max-w-[780px] mx-auto">
      <div class="flex flex-wrap gap-2.5 justify-center mb-8">
        <span class="bg-white/10 border border-white/25 text-white text-xs font-semibold px-4 py-1.5 rounded-full backdrop-blur-sm tracking-wide">PMI</span>
        <span class="bg-white/10 border border-white/25 text-white text-xs font-semibold px-4 py-1.5 rounded-full backdrop-blur-sm tracking-wide">ISO 9001</span>
        <span class="bg-white/10 border border-white/25 text-white text-xs font-semibold px-4 py-1.5 rounded-full backdrop-blur-sm tracking-wide">AWS D1.1-D1.7</span>
        <span class="bg-white/10 border border-white/25 text-white text-xs font-semibold px-4 py-1.5 rounded-full backdrop-blur-sm tracking-wide">IACS</span>
      </div>
      <h1 class="text-[clamp(2.5rem,6vw,4.5rem)] font-extrabold text-white mb-5 leading-tight">
        Soluciones Integrales<br/>
        <span class="bg-gradient-to-r from-[#00A3E0] to-[#F2B800] bg-clip-text text-transparent">de Ingeniería</span>
      </h1>
      <p class="text-[clamp(1rem,2.5vw,1.2rem)] text-white/80 mb-10 leading-relaxed">
        Aliados estratégicos para proyectos de ingeniería naval, industrial y civil.<br/>
        Calidad, precisión y entrega de valor en cada operación.
      </p>
      <div class="flex gap-4 justify-center flex-wrap">
        <a href="#servicios" class="inline-flex items-center gap-2 font-['Outfit'] text-[0.95rem] font-bold px-8 py-3.5 rounded-xl transition-all tracking-wide bg-[#F2B800] text-[#2D3137] hover:bg-[#e0aa00] hover:-translate-y-0.5 hover:shadow-[0_8px_24px_rgba(242,184,0,0.35)]">Ver Servicios</a>
        <a href="#contacto" class="inline-flex items-center gap-2 font-['Outfit'] text-[0.95rem] font-bold px-8 py-3.5 rounded-xl transition-all tracking-wide bg-transparent text-white border-2 border-white/40 hover:bg-white/10 hover:border-white hover:-translate-y-0.5">Solicitar Cotización</a>
      </div>
    </div>
    <div class="hero-scroll-indicator">
      <div class="scroll-dot"></div>
    </div>
  </section>

  <!-- TICKER -->
  <div class="ticker-bar">
    <div class="ticker-track">
      <span>Ingeniería Naval</span>
      <span>Metalmecánica</span>
      <span>Montajes Estructurales</span>
      <span>Mantenimiento de Válvulas</span>
      <span>Equipos Rotativos</span>
      <span>Sistemas HVAC</span>
      <span>Pintura y Sandblasting</span>
      <span>Ingeniería Civil</span>
      <span>ISO 9001</span>
      <span>PMI</span>
      <span>Ingeniería Naval</span>
      <span>Metalmecánica</span>
      <span>Montajes Estructurales</span>
      <span>Mantenimiento de Válvulas</span>
      <span>Equipos Rotativos</span>
      <span>Sistemas HVAC</span>
      <span>Pintura y Sandblasting</span>
      <span>Ingeniería Civil</span>
      <span>ISO 9001</span>
      <span>PMI</span>
    </div>
  </div>

  <!-- QUIÉNES SOMOS -->
  <section class="py-[100px] bg-[#F8FAFC]" id="nosotros">
    <div class="max-w-[1200px] mx-auto px-6">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-10 md:gap-20 items-center">
        <div>
          <div class="inline-block text-[0.78rem] font-bold uppercase tracking-widest text-[#00A3E0] bg-[#00A3E0]/10 border border-[#00A3E0]/20 px-4 py-1.5 rounded-full mb-4">Quienes Somos</div>
          <h2 class="text-[clamp(2rem,4vw,2.8rem)] font-extrabold text-[#2D3137] mb-4">Expertos que <span class="text-[#00A3E0]">generan confianza</span></h2>
          <p class="text-[1.05rem] text-[#64748b] leading-relaxed mb-8">
            Somos una empresa que proporciona soluciones en el área metalmecánica, mantenimiento a equipos rotativos, sistemas de aire acondicionado y adecuaciones locativas. Contamos con un equipo altamente competitivo, con gran experiencia en la industria para la gestión de procesos y proyectos, generando confianza y entrega de valor en cada operación.
          </p>
        </div>
        <div class="relative rounded-2xl overflow-hidden shadow-[0_8px_48px_rgba(10,75,117,0.18)] group">
          <img src="/images/quienes-somos-new.jpg" alt="Equipo ReNaval" class="w-full block transition-transform duration-300 group-hover:scale-105" />
          <div class="absolute top-5 right-5 bg-[#F2B800] text-[#2D3137] font-bold text-[0.85rem] px-4 py-2 rounded-lg shadow-lg">
            +10 años de experiencia
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- MISIÓN, VISIÓN Y VALORES -->
  <section class="bg-gradient-to-br from-[#063350] to-[#0A4B75] py-20">
    <div class="max-w-[1200px] mx-auto px-6">
      <div class="grid grid-cols-1 lg:grid-cols-3 md:grid-cols-2 gap-8">
        <div class="reveal-elem bg-white/5 border border-white/10 rounded-2xl p-10 md:p-12 backdrop-blur-md transition-all hover:bg-white/10 hover:-translate-y-1 border-t-4 border-t-[#00A3E0]">
          <div class="text-[2.5rem] mb-5">🚀</div>
          <h3 class="text-2xl font-extrabold text-white mb-4">Misión</h3>
          <p class="text-white/75 leading-relaxed m-0 text-justify">Ser un aliado estratégico de nuestros clientes a través de brindarles soluciones que estén alineadas con sus objetivos y generar una entrega de valor en cada operación, procesos y proyectos.</p>
        </div>
        <div class="reveal-elem bg-white/5 border border-white/10 rounded-2xl p-10 md:p-12 backdrop-blur-md transition-all hover:bg-white/10 hover:-translate-y-1 border-t-4 border-t-[#F2B800]" style="transition-delay: 150ms">
          <div class="text-[2.5rem] mb-5">🌐</div>
          <h3 class="text-2xl font-extrabold text-white mb-4">Visión</h3>
          <p class="text-white/75 leading-relaxed m-0 text-justify">ReNaval será líder en soluciones para la industria marítima y metalúrgica en construcción o mantenimiento, optimizando los recursos de nuestros clientes y juntos seguir creciendo.</p>
        </div>
        <div class="reveal-elem bg-white/5 border border-white/10 rounded-2xl p-10 md:p-12 backdrop-blur-md transition-all hover:bg-white/10 hover:-translate-y-1 border-t-4 border-t-[#25D366]" style="transition-delay: 300ms">
          <div class="text-[2.5rem] mb-5">💎</div>
          <h3 class="text-2xl font-extrabold text-white mb-4">Valores</h3>
          <p class="text-white/75 leading-relaxed m-0 text-justify">
            <strong class="text-white">Pasión e Integridad.</strong><br/><br/>
            En ReNaval estamos comprometidos con el mejoramiento continuo y el ganar-ganar: si nuestros clientes crecen, nosotros crecemos, y si nosotros crecemos, nuestros clientes crecen, tomando como pilares estos dos valores.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- SERVICIOS -->
  <section class="py-[100px] bg-[#F8FAFC]" id="servicios">
    <div class="max-w-[1200px] mx-auto px-6">
      <div class="text-center mb-16">
        <h2 class="text-[clamp(2rem,4vw,2.8rem)] font-extrabold text-[#2D3137] mb-4">Nuestras <span class="text-[#00A3E0]">Soluciones</span></h2>
        <p class="text-[1.05rem] text-[#64748b] max-w-[560px] mx-auto">Capacidad técnica integral para proyectos industriales, navales y civiles de alta complejidad.</p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        
        <div class="reveal-elem bg-white border border-[#e2e8f0] rounded-2xl p-8 relative overflow-hidden transition-all hover:-translate-y-1.5 hover:shadow-[0_8px_48px_rgba(10,75,117,0.18)] hover:border-transparent group">
          <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-[#00A3E0] to-[#0A4B75] scale-x-0 origin-left transition-transform duration-300 group-hover:scale-x-100"></div>
          <div class="text-[0.72rem] font-extrabold text-[#00A3E0] tracking-widest mb-3">01</div>
          <div class="text-4xl mb-4 block">📋</div>
          <h3 class="text-base font-bold text-[#2D3137] mb-3 leading-snug">Asesoría para Proyectos</h3>
          <p class="text-sm text-[#64748b] leading-relaxed mb-4">Gerencia y evaluación de parámetros en proyectos de construcción y reparación naval, estructuras metálicas y obras civiles mediante metodologías PMI.</p>
          <div class="flex flex-wrap gap-1.5">
            <span class="text-[0.72rem] font-semibold bg-[#F8FAFC] text-[#64748b] px-2.5 py-1 rounded-md transition-colors group-hover:bg-[#00A3E0]/10 group-hover:text-[#00A3E0]">PMI</span>
            <span class="text-[0.72rem] font-semibold bg-[#F8FAFC] text-[#64748b] px-2.5 py-1 rounded-md transition-colors group-hover:bg-[#00A3E0]/10 group-hover:text-[#00A3E0]">Gestión</span>
          </div>
        </div>

        <div class="reveal-elem bg-white border border-[#e2e8f0] rounded-2xl p-8 relative overflow-hidden transition-all hover:-translate-y-1.5 hover:shadow-[0_8px_48px_rgba(10,75,117,0.18)] hover:border-transparent group" style="transition-delay: 100ms">
          <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-[#00A3E0] to-[#0A4B75] scale-x-0 origin-left transition-transform duration-300 group-hover:scale-x-100"></div>
          <div class="text-[0.72rem] font-extrabold text-[#00A3E0] tracking-widest mb-3">02</div>
          <div class="text-4xl mb-4 block">🔩</div>
          <h3 class="text-base font-bold text-[#2D3137] mb-3 leading-snug">Diseño y Fabricación Metalmecánica</h3>
          <p class="text-sm text-[#64748b] leading-relaxed mb-4">Elaboración de planos y fabricación de estructuras en láminas, perfiles IP y tuberías. Soldadura SMAW, MIG y TIG en múltiples materiales.</p>
          <div class="flex flex-wrap gap-1.5">
            <span class="text-[0.72rem] font-semibold bg-[#F8FAFC] text-[#64748b] px-2.5 py-1 rounded-md transition-colors group-hover:bg-[#00A3E0]/10 group-hover:text-[#00A3E0]">SMAW</span>
            <span class="text-[0.72rem] font-semibold bg-[#F8FAFC] text-[#64748b] px-2.5 py-1 rounded-md transition-colors group-hover:bg-[#00A3E0]/10 group-hover:text-[#00A3E0]">MIG</span>
          </div>
        </div>

        <div class="reveal-elem bg-white border border-[#e2e8f0] rounded-2xl p-8 relative overflow-hidden transition-all hover:-translate-y-1.5 hover:shadow-[0_8px_48px_rgba(10,75,117,0.18)] hover:border-transparent group" style="transition-delay: 200ms">
          <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-[#00A3E0] to-[#0A4B75] scale-x-0 origin-left transition-transform duration-300 group-hover:scale-x-100"></div>
          <div class="text-[0.72rem] font-extrabold text-[#00A3E0] tracking-widest mb-3">03</div>
          <div class="text-4xl mb-4 block">🏗️</div>
          <h3 class="text-base font-bold text-[#2D3137] mb-3 leading-snug">Montajes Estructurales</h3>
          <p class="text-sm text-[#64748b] leading-relaxed mb-4">Fabricación e izaje de elementos estructurales IP, soldadura en campo de alta resistencia y durabilidad para infraestructura industrial y naval.</p>
          <div class="flex flex-wrap gap-1.5">
            <span class="text-[0.72rem] font-semibold bg-[#F8FAFC] text-[#64748b] px-2.5 py-1 rounded-md transition-colors group-hover:bg-[#00A3E0]/10 group-hover:text-[#00A3E0]">Estructuras IP</span>
            <span class="text-[0.72rem] font-semibold bg-[#F8FAFC] text-[#64748b] px-2.5 py-1 rounded-md transition-colors group-hover:bg-[#00A3E0]/10 group-hover:text-[#00A3E0]">Izaje</span>
          </div>
        </div>

        <div class="reveal-elem bg-white border border-[#e2e8f0] rounded-2xl p-8 relative overflow-hidden transition-all hover:-translate-y-1.5 hover:shadow-[0_8px_48px_rgba(10,75,117,0.18)] hover:border-transparent group" style="transition-delay: 300ms">
          <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-[#00A3E0] to-[#0A4B75] scale-x-0 origin-left transition-transform duration-300 group-hover:scale-x-100"></div>
          <div class="text-[0.72rem] font-extrabold text-[#00A3E0] tracking-widest mb-3">04</div>
          <div class="text-4xl mb-4 block">🔧</div>
          <h3 class="text-base font-bold text-[#2D3137] mb-3 leading-snug">Mantenimiento de Válvulas</h3>
          <p class="text-sm text-[#64748b] leading-relaxed mb-4">Desarme completo de válvulas y actuadores, inspección ultrasónica, reparación de partes, ensamblaje y pruebas operativas de presión.</p>
          <div class="flex flex-wrap gap-1.5">
            <span class="text-[0.72rem] font-semibold bg-[#F8FAFC] text-[#64748b] px-2.5 py-1 rounded-md transition-colors group-hover:bg-[#00A3E0]/10 group-hover:text-[#00A3E0]">Ultrasonido</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- EXPERIENCIA -->
  <section class="py-[100px]" id="experiencia">
    <div class="max-w-[1200px] mx-auto px-6">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-10 md:gap-20 items-center">
        <div class="order-2 md:order-1 relative rounded-2xl overflow-hidden shadow-[0_8px_48px_rgba(10,75,117,0.18)] group">
          <img src="/images/experiencia-socios.jpg" alt="Experiencia de los socios" class="w-full block transition-transform duration-300 group-hover:scale-105" />
        </div>
        <div class="order-1 md:order-2">
          <h2 class="text-[clamp(2rem,4vw,2.8rem)] font-extrabold text-[#2D3137] mb-4">Experiencia de <span class="text-[#00A3E0]">los Socios</span></h2>
          <p class="text-[1.05rem] text-[#64748b] leading-relaxed mb-8">
            Cada uno de los miembros del equipo cuenta con más de 10 años de experiencia en la industria desde la operación y gerencia, desarrollando proyectos bajo normas según sea exigido por el cliente en la industria naval o metalúrgica, aplicando metodologías como LEAN, SMED, TPM, KAIZEN, entre otras, para la optimización de los procesos.
          </p>
          <div class="flex flex-wrap gap-2">
            <span class="bg-[#0A4B75] text-white text-[0.75rem] font-bold px-3 py-1.5 rounded-md">ISO 9001</span>
            <span class="bg-[#00A3E0] text-white text-[0.75rem] font-bold px-3 py-1.5 rounded-md">AWS D1.1–D1.7</span>
            <span class="bg-[#F2B800] text-[#2D3137] text-[0.75rem] font-bold px-3 py-1.5 rounded-md">PMI</span>
            <span class="bg-[#0A4B75] text-white text-[0.75rem] font-bold px-3 py-1.5 rounded-md">IACS</span>
            <span class="bg-[#00A3E0] text-white text-[0.75rem] font-bold px-3 py-1.5 rounded-md">LEAN</span>
            <span class="bg-[#F2B800] text-[#2D3137] text-[0.75rem] font-bold px-3 py-1.5 rounded-md">KAIZEN</span>
            <span class="bg-[#0A4B75] text-white text-[0.75rem] font-bold px-3 py-1.5 rounded-md">TPM</span>
            <span class="bg-[#00A3E0] text-white text-[0.75rem] font-bold px-3 py-1.5 rounded-md">SMED</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- GALERÍA DE TRABAJOS -->
  <section class="py-[100px] bg-[#F8FAFC]" id="galeria">
    <div class="max-w-[1200px] mx-auto px-6">
      <div class="text-center mb-16">
        <div class="inline-block text-[0.78rem] font-bold uppercase tracking-widest text-[#00A3E0] bg-[#00A3E0]/10 border border-[#00A3E0]/20 px-4 py-1.5 rounded-full mb-4">Galería</div>
        <h2 class="text-[clamp(2rem,4vw,2.8rem)] font-extrabold text-[#2D3137] mb-4">Trabajos <span class="text-[#00A3E0]">Realizados</span></h2>
        <p class="text-[1.05rem] text-[#64748b] max-w-[560px] mx-auto">Una muestra de nuestra capacidad técnica en proyectos navales, metalúrgicos y de mantenimiento industrial.</p>
      </div>

      <!-- CARRUSEL -->
      <div class="relative" id="gallery-carousel">

        <!-- Slide principal -->
        <div class="relative overflow-hidden rounded-2xl shadow-[0_12px_48px_rgba(10,75,117,0.18)] bg-[#1a2332] cursor-zoom-in"
             id="carousel-main" style="height:clamp(300px,55vw,600px);">
          <img id="carousel-img" src="/images/PHOTO-2026-09-25-07-15-52.jpg" alt="Soldadura en casco de embarcación"
               class="w-full h-full object-cover" style="transition:opacity .22s ease;" />
          <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-transparent to-transparent pointer-events-none"></div>
          <div class="absolute bottom-0 left-0 right-0 p-6 flex items-end justify-between">
            <div>
              <p id="carousel-caption" class="text-white font-bold text-lg leading-tight drop-shadow">Soldadura Naval</p>
              <p id="carousel-sub" class="text-white/70 text-sm mt-0.5">Foto 1 de 12</p>
            </div>
            <button id="carousel-zoom-btn"
                    class="bg-white/20 hover:bg-white/35 backdrop-blur-sm text-white p-2.5 rounded-lg transition-all border border-white/20"
                    aria-label="Ver en zoom">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35M11 17A6 6 0 1 0 11 5a6 6 0 0 0 0 12zm-3-6h6m-3-3v6"/>
              </svg>
            </button>
          </div>
        </div>

        <!-- Flecha izquierda -->
        <button id="prev-btn"
                class="absolute left-3 z-10 bg-white/90 hover:bg-white text-[#0A4B75] w-11 h-11 rounded-full shadow-lg flex items-center justify-center transition-all hover:scale-110 border border-white/50"
                style="top:calc(clamp(300px,55vw,600px)/2 - 22px);"
                aria-label="Foto anterior">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/>
          </svg>
        </button>

        <!-- Flecha derecha -->
        <button id="next-btn"
                class="absolute right-3 z-10 bg-white/90 hover:bg-white text-[#0A4B75] w-11 h-11 rounded-full shadow-lg flex items-center justify-center transition-all hover:scale-110 border border-white/50"
                style="top:calc(clamp(300px,55vw,600px)/2 - 22px);"
                aria-label="Foto siguiente">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
          </svg>
        </button>

        <!-- Miniaturas -->
        <div class="mt-4 flex gap-3 overflow-x-auto pb-2" id="carousel-thumbs"
             style="scrollbar-width:thin;scrollbar-color:#00A3E0 #e2e8f0;"></div>

        <!-- Puntos indicadores -->
        <div class="flex justify-center gap-2 mt-5" id="carousel-dots"></div>

      </div><!-- /gallery-carousel -->
    </div>
  </section>

  <!-- LIGHTBOX ZOOM -->
  <div id="lightbox" role="dialog" aria-modal="true" aria-label="Zoom de imagen"
       class="fixed inset-0 z-[9999] flex items-center justify-center p-4"
       style="background:rgba(0,0,0,0.93);opacity:0;pointer-events:none;transition:opacity .3s ease;backdrop-filter:blur(8px);">

    <button id="lb-close"
