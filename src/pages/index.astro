  <script>
    (function () {
      const GALLERY = [
        { src: '/images/PHOTO-2026-09-25-07-15-52.jpg',   label: 'Soldadura Naval',           desc: 'Soldadura en casco de embarcaci\u00f3n' },
        { src: '/images/PHOTO-2026-09-25-07-15-52 2.jpg', label: 'Estructuras Met\u00e1licas',     desc: 'Fabricaci\u00f3n de estructura met\u00e1lica en interior' },
        { src: '/images/PHOTO-2026-09-25-07-16-05 2.jpg', label: 'Mantenimiento de Equipos',  desc: 'T\u00e9cnico ReNaval en sala de m\u00e1quinas' },
        { src: '/images/PHOTO-2026-09-25-07-16-02.jpg',   label: 'Operaciones en Cubierta',   desc: 'Soldador ReNaval trabajando en cubierta' },
        { src: '/images/PHOTO-2026-09-25-07-15-56 2.jpg', label: 'Fabricaci\u00f3n Naval',         desc: 'Estructura naval fabricada y pintada' },
        { src: '/images/PHOTO-2026-09-25-07-16-05 4.jpg', label: 'Mantenimiento de V\u00e1lvulas', desc: 'V\u00e1lvulas industriales restauradas' },
        { src: '/images/PHOTO-2026-09-25-07-15-55.jpg',   label: 'Reparaci\u00f3n de Cascos',      desc: 'Reparaci\u00f3n de casco en astillero' },
        { src: '/images/PHOTO-2026-09-25-07-16-01.jpg',   label: 'Tuber\u00edas Industriales',     desc: 'Tuber\u00edas en acero inoxidable fabricadas' },
        { src: '/images/PHOTO-2026-09-25-07-16-05.jpg',   label: 'Overhaul de V\u00e1lvulas',      desc: 'V\u00e1lvula restaurada y pintada' },
        { src: '/images/PHOTO-2026-09-25-07-15-56.jpg',   label: 'Pintura Anticorrosiva',     desc: 'Pintura anticorrosiva en casco de embarcaci\u00f3n' },
        { src: '/images/PHOTO-2026-09-25-07-16-04.jpg',   label: 'Trabajos en Muelle',        desc: 'Trabajo en muelle - soldadura y reparaciones' },
        { src: '/images/PHOTO-2026-09-25-07-16-04 4.jpg', label: 'Fabricaci\u00f3n en Aluminio',   desc: 'Escalera en aluminio para embarcaci\u00f3n' },
      ];

      let idx = 0;
      let lbOpen = false;
      let autoTimer = null;

      const cImg   = document.getElementById('carousel-img');
      const cCap   = document.getElementById('carousel-caption');
      const cSub   = document.getElementById('carousel-sub');
      const thumbs = document.getElementById('carousel-thumbs');
      const dots   = document.getElementById('carousel-dots');
      const lb     = document.getElementById('lightbox');
      const lbImg  = document.getElementById('lb-img');
      const lbCap  = document.getElementById('lb-caption');
      const lbCnt  = document.getElementById('lb-counter');

      // Construir miniaturas y dots
      GALLERY.forEach(function(item, i) {
        var th = document.createElement('button');
        th.className = 'flex-shrink-0 w-20 h-16 rounded-lg overflow-hidden border-2 transition-all focus:outline-none ' +
                       (i === 0 ? 'border-[#00A3E0] opacity-100 scale-105' : 'border-transparent opacity-55 hover:opacity-85');
        th.setAttribute('aria-label', item.label);
        th.innerHTML = '<img src="' + item.src + '" alt="' + item.label + '" class="w-full h-full object-cover" loading="lazy"/>';
        th.addEventListener('click', function() { goTo(i); });
        thumbs.appendChild(th);

        var d = document.createElement('button');
        d.className = 'rounded-full border-none cursor-pointer focus:outline-none transition-all';
        d.style.cssText = 'height:8px;background:' + (i === 0 ? '#00A3E0' : '#cbd5e1') + ';width:' + (i === 0 ? '24' : '8') + 'px;';
        d.setAttribute('aria-label', 'Foto ' + (i + 1));
        d.addEventListener('click', function() { goTo(i); });
        dots.appendChild(d);
      });

      function goTo(n) {
        idx = ((n % GALLERY.length) + GALLERY.length) % GALLERY.length;
        var item = GALLERY[idx];

        cImg.style.opacity = '0';
        setTimeout(function() { cImg.src = item.src; cImg.alt = item.desc; cImg.style.opacity = '1'; }, 180);
        cCap.textContent = item.label;
        cSub.textContent = 'Foto ' + (idx + 1) + ' de ' + GALLERY.length;

        thumbs.querySelectorAll('button').forEach(function(t, i) {
          t.className = 'flex-shrink-0 w-20 h-16 rounded-lg overflow-hidden border-2 transition-all focus:outline-none ' +
                        (i === idx ? 'border-[#00A3E0] opacity-100 scale-105' : 'border-transparent opacity-55 hover:opacity-85');
          if (i === idx) t.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
        });

        dots.querySelectorAll('button').forEach(function(d, i) {
          d.style.background = i === idx ? '#00A3E0' : '#cbd5e1';
          d.style.width = (i === idx ? 24 : 8) + 'px';
        });

        if (lbOpen) syncLb();
      }

      function syncLb() {
        var item = GALLERY[idx];
        lbImg.style.opacity = '0';
        setTimeout(function() { lbImg.src = item.src; lbImg.alt = item.desc; lbImg.style.opacity = '1'; }, 150);
        lbCap.textContent = item.label;
        lbCnt.textContent = (idx + 1) + ' / ' + GALLERY.length;
      }

      function openLb() {
        syncLb();
        lb.style.opacity = '1';
        lb.style.pointerEvents = 'all';
        document.body.style.overflow = 'hidden';
        lbOpen = true;
        stopAuto();
      }

      function closeLb() {
        lb.style.opacity = '0';
        lb.style.pointerEvents = 'none';
        document.body.style.overflow = '';
        lbOpen = false;
        startAuto();
      }

      function startAuto() { autoTimer = setInterval(function() { goTo(idx + 1); }, 5000); }
      function stopAuto()  { clearInterval(autoTimer); }

      // Controles carrusel
      document.getElementById('prev-btn').addEventListener('click', function() { goTo(idx - 1); });
      document.getElementById('next-btn').addEventListener('click', function() { goTo(idx + 1); });
      document.getElementById('carousel-main').addEventListener('click', openLb);
      document.getElementById('carousel-zoom-btn').addEventListener('click', function(e) { e.stopPropagation(); openLb(); });

      var wrap = document.getElementById('gallery-carousel');
      wrap.addEventListener('mouseenter', stopAuto);
      wrap.addEventListener('mouseleave', function() { if (!lbOpen) startAuto(); });
      startAuto();

      // Swipe carrusel
      var tsx = 0;
      var cs = document.getElementById('carousel-main');
      cs.addEventListener('touchstart', function(e) { tsx = e.touches[0].clientX; }, { passive: true });
      cs.addEventListener('touchend', function(e) {
        if (Math.abs(tsx - e.changedTouches[0].clientX) > 40) goTo(tsx > e.changedTouches[0].clientX ? idx + 1 : idx - 1);
      }, { passive: true });

      // Controles lightbox
      document.getElementById('lb-close').addEventListener('click', closeLb);
      document.getElementById('lb-prev').addEventListener('click', function(e) { e.stopPropagation(); goTo(idx - 1); });
      document.getElementById('lb-next').addEventListener('click', function(e) { e.stopPropagation(); goTo(idx + 1); });
      lb.addEventListener('click', function(e) { if (e.target === lb) closeLb(); });

      document.addEventListener('keydown', function(e) {
        if (!lbOpen) return;
        if (e.key === 'Escape') closeLb();
        if (e.key === 'ArrowLeft')  goTo(idx - 1);
        if (e.key === 'ArrowRight') goTo(idx + 1);
      });

      // Swipe lightbox
      var lbx = 0;
      lb.addEventListener('touchstart', function(e) { lbx = e.touches[0].clientX; }, { passive: true });
      lb.addEventListener('touchend', function(e) {
        if (Math.abs(lbx - e.changedTouches[0].clientX) > 40) goTo(lbx > e.changedTouches[0].clientX ? idx + 1 : idx - 1);
      }, { passive: true });
    })();
  </script>


